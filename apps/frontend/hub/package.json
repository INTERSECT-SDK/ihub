{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "config": {
    "port": "3000"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --port $npm_package_config_port",
    "build": "next build",
    "start": "next start --port $npm_package_config_port",
    "test:unit": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:launcher-tour:e2e": "playwright test --config=playwright.launcher-tour.config.ts",
    "test:project-files:e2e": "playwright test --config=playwright.project-files.config.ts",
    "format": "prettier --config .prettierrc --write ./src",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ihub/ui": "workspace:*",
    "@ihub/utils": "workspace:*",
    "@jupyterlab/services": "^7.5.0",
    "@langchain/core": "^1.1.4",
    "@langchain/ollama": "^1.0.3",
    "@langchain/openai": "^1.1.3",
    "@mantine/core": "^8.3.16",
    "@mantine/form": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@mantinex/dev-icons": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@monaco-editor/react": "^4.7.0",
    "@next/env": "16.1.6",
    "@tabler/icons-react": "^3.26.0",
    "@types/json2md": "^1.5.4",
    "@uiw/react-codemirror": "^4.25.3",
    "@xyflow/react": "^12.10.0",
    "ansi-to-html": "^0.7.2",
    "axios": "^1.13.2",
    "elkjs": "^0.11.0",
    "install": "^0.13.0",
    "jotai": "^2.16.0",
    "json2md": "^2.0.3",
    "lowlight": "^3.3.0",
    "next": "<17.0.0",
    "plotly.js": "^3.3.0",
    "plotly.js-dist": "^3.3.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-vega": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.3.7",
    "tailwind-preset-mantine": "^1.3.2",
    "uuid": "^13.0.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.1",
    "wscat": "^6.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "1.61.0",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "<17.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "postcss": "^8",
    "postcss-preset-mantine": "^1.17.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
