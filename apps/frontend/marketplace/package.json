    "@tabler/icons-react": "^3.35.0",
    "jotai": "^2.16.0",
    "next": "<17.0.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "<17.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "postcss": "^8",
    "postcss-preset-mantine": "^1.17.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.1",
