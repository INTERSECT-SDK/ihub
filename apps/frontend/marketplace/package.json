{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "config": {
    "port": "3001"
  },
  "scripts": {
    "dev": "next dev --turbopack --port $npm_package_config_port",
    "build": "next build --turbopack",
    "start": "next start --port $npm_package_config_port",
    "lint": "eslint ./src",
    "format": "prettier --config .prettierrc --write ./src"
  },
  "dependencies": {
    "@ihub/ui": "workspace:*",
    "@ihub/utils": "workspace:*",
    "@mantine/core": "^8.3.16",
