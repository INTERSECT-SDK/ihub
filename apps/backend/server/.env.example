# Copy this file to .env and change it as desired
# Note that a .env file is not necessary if all of these values are environment variables

LOG_LEVEL=DEBUG
# 'development' or 'production'
ENVIRONMENT=development
# 'dev_bypass' for development only
# 'oauth' for production (or development if you want to test with real auth)
AUTH_MODE=dev_bypass
# any values, only used if AUTH_MODE=dev_bypass
DEV_AUTH_EMAIL=dev.user@example.com
DEV_AUTH_NAME=Dev User

# the queue name for iHub consuming INTERSECT messages
# set accordingly, especially if multiple instances of iHub connect to the same broker
RESERVED_BROKER_QUEUE_NAME=ihub-dev-changeme

# Maximum raw project file upload size (10 MiB by default). Nginx derives its
# JSON/base64 request-body allowance from this value automatically. When using
# docker-compose.dev.yml, set the same value for the host-run API process.
PROJECT_FILE_UPLOAD_MAX_BYTES=10485760

# CORS - if you want to disable CORS, just don't define this environment variable
CORS_ORIGINS='["*"]'

VERSION=0.1.0

# postgresql stuff
POSTGRESQL_USERNAME=ihub_username
POSTGRESQL_PASSWORD=ihub_password
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=ihub

# oauth variables. Change to appropriate values for your deployment.



# Copy this file to .env and change it as desired
# Note that a .env file is not necessary if all of these values are environment variables

LOG_LEVEL=DEBUG

# CORS - if you want to disable CORS, just don't define this environment variable
CORS_ORIGINS='["*"]'

# PostgreSQL Database
POSTGRESQL_USERNAME=ihub_username
POSTGRESQL_PASSWORD=ihub_password
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=ihub

PORT=8000

ENVIRONMENT=development
AUTH_MODE=dev_bypass
DEV_AUTH_EMAIL=dev.user@example.com
DEV_AUTH_NAME='Dev User'
 

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PROTOCOL=3
REDIS_DB=0 
REDIS_DECODE_RESPONSES=True

# Flowcept Redis connections. Override these through the deployment environment
# or an approved secret manager when credentials are required.
MQ_URI=redis://localhost:6379
KVDB_URI=redis://localhost:6379


JH_HOST=http://localhost:8080/ijupyterhub
JH_ADMIN_TOKEN=ihub_jupyter_hub_secret_key


# oauth variables. Change to appropriate values for your deployment.
auth_redirect_url='http://localhost:8080/hub/auth'
SESSION_SECRET='changeme'
SCOPE='openid email'
OAUTH_CALLBACK_URL='http://localhost:8080/api/v1/auth/callback'
OAUTH_REDIRECT_URL='http://localhost:8080/hub/auth'
OAUTH_UNAUTHORIZED_REDIRECT_URL='http://localhost:8080/hub/unauthorized'


CLIENT_ID=changeme
CLIENT_SECRET=changeme
keycloak_authorize_url=changeme
keycloak_token_url=changeme
OAUTH_USERDATA_URL=changeme
keycloak_jwks_url=changeme
