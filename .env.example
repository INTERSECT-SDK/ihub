# the queue name for iHub consuming INTERSECT messages
# set accordingly, especially if multiple instances of iHub connect to the same broker
RESERVED_BROKER_QUEUE_NAME=ihub

# PostgreSQL Database
POSTGRESQL_USERNAME=ihub_username
POSTGRESQL_PASSWORD=ihub_password
POSTGRESQL_DATABASE=ihub

# JupyterHub configuration
JUYTER_HUB_ADMIN_TOKEN=ihub_jupyter_hub_secret_key
JUPYTER_PUBLIC_URL=http://localhost:8080/ijupyterhub
JUPYTER_OAUTH_CALLBACK_URL=http://localhost:8080/ijupyterhub/hub/oauth_callback
JUPYTER_VALIDATE_CERT=False
JUPYTER_SECURE_COOKIES=False
JUPYTERHUB_SECURE_COOKIES=False

# Authentication mode (for dev or prod)
# 'development' or 'production'
ENVIRONMENT=development
# 'dev_bypass' for development only
# 'oauth' for production (or development if you want to test with real auth)
AUTH_MODE=dev_bypass
# any values, only used if AUTH_MODE=dev_bypass
DEV_AUTH_EMAIL=dev.user@example.com
DEV_AUTH_NAME=Dev User

# Maximum raw project file upload size (10 MiB by default). Nginx derives its
# JSON/base64 request-body allowance from this value automatically. For the
# lightweight docker-compose.dev.yml proxy, use this same value in the host API.
PROJECT_FILE_UPLOAD_MAX_BYTES=10485760

# Production Nginx TLS. The Compose stack mounts these files read-only; keep
# certificate and private-key contents outside the repository and this file.
NGINX_SERVER_NAME=ihub.example.com
TLS_CERT_FILE=/etc/ssl/ihub/cert.pem
TLS_KEY_FILE=/etc/ssl/ihub/private.key

# Full-development and production Compose use the in-stack Redis service for
# Flowcept by default. Set these only to override that deployment default;
# credentials belong in an approved secret manager, never in this file.
# MQ_URI=rediss://flowcept-mq.example.com:6380
# KVDB_URI=rediss://flowcept-kv.example.com:6380

# OAuth configuration 
SESSION_SECRET=changeme
SCOPE=openid email
CLIENT_ID=changeme
CLIENT_SECRET=changeme
keycloak_authorize_url=changeme
keycloak_token_url=changeme
OAUTH_USERDATA_URL=changeme
keycloak_jwks_url=changeme
OAUTH_CALLBACK_URL=changeme
OAUTH_REDIRECT_URL=changeme
auth_redirect_url=changeme

# iHub Keycloak configuration (not used at the moment)
KEYCLOAK_STARTING_ADMIN_USERNAME=admin
KEYCLOAK_STARTING_ADMIN_PASSWORD=changethispasswordforadmin
