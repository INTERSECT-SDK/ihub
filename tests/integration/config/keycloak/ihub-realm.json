{
  "realm": "ihub",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "ihub",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ihub-it-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["+"]
    }
  ],
  "users": [
    {
      "username": "it-user",
      "email": "it.user@example.com",
      "emailVerified": true,
      "firstName": "Integration",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "it-password", "temporary": false }
      ]
    }
  ]
}
